{"bookSourceComment":"作者：\n姚浅书","bookSourceGroup":"自制","bookSourceName":"爱看吧","bookSourceType":0,"bookSourceUrl":"https://ik8.net","bookUrlPattern":"https://ik8\\.net/book\\d+/?","customButton":false,"customOrder":1,"enabled":true,"enabledCookieJar":true,"enabledExplore":true,"eventListener":false,"exploreUrl":"长篇::https://ik8.net/booklist1/{{page}}.html\n综合::https://ik8.net/booklist2/{{page}}.html\n武侠::https://ik8.net/booklist3/{{page}}.html\n历史::https://ik8.net/booklist4/{{page}}.html\n都市::https://ik8.net/booklist5/{{page}}.html\n玄幻::https://ik8.net/booklist6/{{page}}.html\n女生::https://ik8.net/booklist7/{{page}}.html\n其他::https://ik8.net/booklist8/{{page}}.html\n现代::https://ik8.net/booklist9/{{page}}.html","header":"{\"User-Agent\": \"Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36\", \"Referer\": \"https://ik8.net/\"}","ruleBookInfo":{"author":"meta[property=og:novel:author]@content","coverUrl":"meta[property=og:image]@content","intro":"meta[name=description]@content","kind":"meta[property=og:novel:category]@content","lastChapter":"class.options@tag.li.4@tag.a@text","name":"meta[property=og:novel:book_name]@content"},"ruleContent":{"content":"<js>\nvar html = String(result);\n// 1. 从 HTML 提取 ch() 里的全部 POST 参数\nvar mu = html.match(/\"url\"\\s*:\\s*\"([^\"]+)\"/);\nvar mn = html.match(/\"novel\"\\s*:\\s*\"([^\"]+)\"/);\nvar mc = html.match(/\"chapter\"\\s*:\\s*\"([^\"]+)\"/);\nvar mt = html.match(/\"t\"\\s*:\\s*(\\d+)/);\nvar mn2 = html.match(/\"n\"\\s*:\\s*\"([^\"]+)\"/);\nvar ms = html.match(/\"sign\"\\s*:\\s*\"([^\"]+)\"/);\nif (!mu || !ms || !mn || !mc || !mt || !mn2) {\n  java.log('参数提取失败');\n  '正文参数提取失败，请刷新重试';\n} else {\n  // 2. 清洗 HTML：只删恶意劫持脚本，保留其他资源让 onPageFinished 正常触发\n  html = html.replace(/<script[^>]*src=\"[^\"]*(comprelu|dsygc)[^\"]*\"[^>]*><\\/script>/gi, '');\n  // 3. 注入 8 秒 window.stop() 兜底，强制触发 onPageFinished\n  var forceStop = '<script>setTimeout(function(){try{if(window.stop)window.stop();}catch(e){}},8000);<\\/script>';\n  html = html.replace(/<head[^>]*>/i, '<head>' + forceStop);\n  // 4. 构造完全同步的注入脚本：原生同步 XHR，不依赖 jQuery，不依赖 Promise\n  var bodyJs = 'url=' + mu[1] + '&mobile=1&isk=1&novel=' + mn[1] + '&chapter=' + mc[1] + '&t=' + mt[1] + '&n=' + mn2[1] + '&sign=' + ms[1];\n  var script = '(function(){try{'\n    + 'var body=\"' + bodyJs.replace(/\"/g, '\\\\\"') + '\";'\n    + 'var xhr=new XMLHttpRequest();'\n    + 'xhr.open(\"POST\",\"/conapi.php\",false);'\n    + 'xhr.setRequestHeader(\"Content-Type\",\"application/x-www-form-urlencoded; charset=UTF-8\");'\n    + 'xhr.setRequestHeader(\"X-Requested-With\",\"XMLHttpRequest\");'\n    + 'xhr.send(body);'\n    + 'if(xhr.status!==200)return \"HTTP:\"+xhr.status;'\n    + 'var r=JSON.parse(xhr.responseText);'\n    + 'if(r.success==1&&r.content)return r.content;'\n    + 'return \"FAIL:\"+String(r.content||\"unknown\");'\n    + '}catch(e){return \"ERR:\"+e.message;}})()';\n  java.log('清洗后 html len=' + html.length + ' bodyJs len=' + bodyJs.length);\n  var res = '';\n  try { res = String(java.webView(html, baseUrl, script)); } catch(e) { java.log('webView err:' + e); res = ''; }\n  java.log('webView res len=' + res.length + ' head=' + res.substring(0, 100));\n  if (res.indexOf('ERR:') === 0 || res.indexOf('FAIL:') === 0 || res.indexOf('HTTP:') === 0 || res.length < 30) {\n    '正文加载失败: ' + res.substring(0, 100);\n  } else {\n    var lines = res.split('\\n');\n    var out = [];\n    for (var i = 0; i < lines.length; i++) {\n      var L = lines[i].trim();\n      if (L.length > 0) { out.push('<p>' + L + '</p>'); }\n    }\n    out.join('\\n');\n  }\n}\n</js>"},"ruleExplore":{"author":"class.author@text","bookList":"class.box@tag.li","bookUrl":"tag.h3@tag.a@href","coverUrl":"tag.img@src","kind":"class.sort@text","lastChapter":"class.update@tag.a@text","name":"tag.h3@tag.a@text"},"ruleSearch":{"author":"tag.dd.book_other.0@tag.span@tag.a@text","bookList":"tag.dl","bookUrl":"tag.h3@tag.a@href","coverUrl":"tag.dt@tag.img@src","lastChapter":"tag.dd.book_other.3@tag.a@text","name":"tag.h3@tag.a@text"},"ruleToc":{"chapterList":"class.book_list2@tag.li","chapterName":"tag.a@text","chapterUrl":"tag.a@href"},"searchUrl":"https://ik8.net/e/search/index.php?keyboard={{key}}&show=title,writer,byr&searchget=1","weight":0}